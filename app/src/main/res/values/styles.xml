<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The on-screen keyboard's key style, carried over from SmartView
        unchanged. The X3's own IME renders into the raw 1280x480
        framebuffer, so it lands across both eyes at the wrong scale and
        cannot be dismissed by looking at it — this keyboard replaces it.

        Grey rather than black on purpose: black is transparent on the
        waveguide, so black keys on a black backdrop would leave the wearer
        pressing invisible buttons.
    -->
    <style name="KeyboardButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/darker_gray</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:padding">2dp</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
